#!/bin/bash
# A stand-in for claude: conversations kept in ~/.fake-claude/<id>.conv,
# resumed with --resume <id> or --continue, and — like claude's own hooks —
# each turn reports its conversation id through `reminal hook`.
mkdir -p ~/.fake-claude
echo "argv: $*" >> ~/.fake-claude/argv.log
conv=""
while [ $# -gt 0 ]; do
    case "$1" in
        --resume) conv="$2"; shift ;;
        --continue) conv=$(ls -t ~/.fake-claude/*.conv 2>/dev/null | head -1 | xargs -r basename | sed 's/\.conv$//') ;;
    esac
    shift
done
if [ -n "$conv" ] && [ -f ~/.fake-claude/"$conv".conv ]; then
    echo "fake-claude: resumed conversation $conv"
    sed 's/^/  (earlier) /' ~/.fake-claude/"$conv".conv
else
    conv="conv-$(head -c6 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    : > ~/.fake-claude/"$conv".conv
    echo "fake-claude: new conversation $conv"
fi
hook() { printf '{"session_id":"%s","hook_event_name":"%s"}' "$conv" "$2" | reminal hook "$1" 2>/dev/null; }
hook done Stop
while printf 'claude> ' && read -r line; do
    hook working UserPromptSubmit
    echo "you said: $line" | tee -a ~/.fake-claude/"$conv".conv
    hook done Stop
done
